{
    "name": "toshkq93/behavior-diff-laravel",
    "description": "Laravel adapter for toshkq93/behavior-diff: finds routes, validation rules and model bindings, runs the requests inside the application with transactions, fakes and a frozen clock.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "upgrade",
        "migration",
        "regression",
        "testing",
        "diff",
        "legacy"
    ],
    "homepage": "https://github.com/toshkq93/behavior-diff-laravel",
    "authors": [
        {
            "name": "toshkq93",
            "homepage": "https://github.com/toshkq93"
        }
    ],
    "require": {
        "php": ">=7.1",
        "illuminate/console": "^5.5|^6.0|^7.0|^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^5.5|^6.0|^7.0|^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^5.5|^6.0|^7.0|^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/routing": "^5.5|^6.0|^7.0|^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^5.5|^6.0|^7.0|^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "toshkq93/behavior-diff": "^0.1"
    },
    "require-dev": {
        "orchestra/testbench": "^6.0|^7.0|^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^9.6|^10.5|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Toshkq93\\BehaviorDiffLaravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Toshkq93\\BehaviorDiffLaravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Toshkq93\\BehaviorDiffLaravel\\BehaviorDiffServiceProvider"
            ]
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../behavior-diff",
            "options": {
                "symlink": true,
                "versions": {
                    "toshkq93/behavior-diff": "0.1.0"
                }
            }
        }
    ],
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true,
        "platform-check": false
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
